# Required to log in at /admin
ADMIN_PASSWORD=choose-a-long-password

# Use a separate, random value (32+ characters) in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Required only for movie lookup in the admin. Create a free API key at themoviedb.org.
# This value is read only in authenticated server functions and is never sent to browsers.
TMDB_API_KEY=

# Omit both TURSO values locally: Shelf uses file:data/shelf.db.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
