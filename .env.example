# Used only to bootstrap the first admin at /admin/login. After that, users log
# in with their stored email and password.
ADMIN_PASSWORD=choose-a-long-password

# Required only for signed-in movie lookup. Create a free API key at themoviedb.org.
# This value is read only in authenticated server functions and is never sent to browsers.
TMDB_API_KEY=

# Optional: enables disc (Blu-ray/DVD) barcode lookup via UPCitemdb.
UPCMDB_API_KEY=

# Optional: stores remote cover images in Vercel Blob when an item is saved.
BLOB_READ_WRITE_TOKEN=

# Required for the private agent JSON API (/api/items).
SHELF_AGENT_TOKEN=

# Omit both TURSO values locally: Shelf uses file:/tmp/shelf.db.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
