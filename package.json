{
  "name": "shelf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxfmt --check",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "routes:generate": "tsr generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f /tmp/shelf.db && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@blossom-carousel/react": "^1.5.2",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@vercel/blob": "^2.8.0",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.33",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
